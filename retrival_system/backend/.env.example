# ═══════════════════════════════════════════════════════════════════
# Signora Backend – Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# NEVER commit .env to version control — it contains secrets.
# ═══════════════════════════════════════════════════════════════════

# ── Required ───────────────────────────────────────────────────────

# PostgreSQL connection URL (must use the psycopg driver).
# Use a restricted application account; migration needs schema-creation privileges.
SIGNORA_DATABASE_URL=postgresql+psycopg://signora_app:YOUR_PASSWORD@127.0.0.1:55432/signora

# Directory where immutable motion assets are stored.
SIGNORA_STORAGE_ROOT=D:/SignoraData/storage

# ── Authentication ─────────────────────────────────────────────────

# JSON mapping: SHA-256(bearer-token) → { subject, roles[], expires_at, station_ids[] }
# Generate random tokens outside source control.
# Roles: admin, reviewer, operator, display
# Example (replace with real SHA-256 digests and expiry dates):
SIGNORA_PRINCIPALS={"sha256hex_of_admin_token":{"subject":"admin-user","roles":["admin"],"expires_at":"2027-01-01T00:00:00+05:30"},"sha256hex_of_operator_token":{"subject":"operator-user","roles":["operator"],"expires_at":"2027-01-01T00:00:00+05:30","station_ids":["NAGPUR"]}}

# ── Import Sources ─────────────────────────────────────────────────

# JSON mapping of alias → source directory for bulk asset import.
# Each directory must contain metadata/ and glb/ subdirectories.
SIGNORA_IMPORT_ROOTS={"library":"D:/ai_retrival_based system/metadata_json and glb"}

# ── Optional: ASR (Speech Recognition) ─────────────────────────────

# Path to the provisioned Whisper model directory.
# Download first: uv run --extra asr signora-asr-download artifacts/asr-model
# SIGNORA_ASR_MODEL_PATH=D:/path/to/artifacts/asr-model
# SIGNORA_ASR_TIMEOUT_SECONDS=90

# ── Optional: Semantic Retrieval (E5 Embeddings) ───────────────────

# Path to the provisioned E5 encoder model directory.
# Download first: uv run --extra retrieval signora-encoder-download artifacts/e5-model
# SIGNORA_ENCODER_MODEL_PATH=D:/path/to/artifacts/e5-model
# SIGNORA_ENCODER_TIMEOUT_SECONDS=60

# ── WebSocket / Display ────────────────────────────────────────────

# Allowed WebSocket origins (JSON array). Deny all by default.
SIGNORA_WEBSOCKET_ORIGINS=["http://127.0.0.1:3000"]

# Display connection settings
# SIGNORA_DISPLAY_LEASE_SECONDS=15
# SIGNORA_DISPLAY_POLL_SECONDS=1
# SIGNORA_DISPLAY_CONNECTION_LIMIT=64

# ── Lifecycle ──────────────────────────────────────────────────────

# Minimum days since last activity before a motion version can be deleted.
# SIGNORA_DELETION_RETENTION_DAYS=30

# ── Development ────────────────────────────────────────────────────

# Enable demo mode for development preview and live delivery.
# SIGNORA_DEMO_MODE_ENABLED=false
